# Admin login
ADMIN_USER=admin
ADMIN_PASSWORD=fgm-admin
ADMIN_SESSION_SECRET=replace-with-a-long-random-string

# Durable content storage (recommended on Vercel)
# Create a Vercel KV / Upstash Redis database, then paste its REST credentials.
# Without these, content falls back to local memory and will not persist in production.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional local storage directory (defaults to ./data; /tmp on Vercel)
# CONTENT_STORE_DIR=
